# ------------------------------------------------------------------
# LearnForge AI - Environment Configuration
# Copy this file to .env and adjust the values.
# ------------------------------------------------------------------

# Flask session signing key. Use a long random string in production.
SECRET_KEY=change-me-to-a-long-random-string

# SQLite database location (optional - defaults to instance/app.db)
# DATABASE_URL=sqlite:///instance/app.db

# Seeded administrator (created on first run, never through public signup)
ADMIN_NAME=Platform Administrator
ADMIN_EMAIL=admin@learnforge.com
ADMIN_PASSWORD=Admin@12345

# ------------------------------------------------------------------
# Multi-Provider AI Configuration
# AI_PROVIDER supports: groq | openrouter | gemini | nvidia | openai
# ------------------------------------------------------------------
AI_PROVIDER=groq
AI_MODEL=qwen/qwen3.8-27b
AI_AUTO_FAILOVER=true
AI_TIMEOUT=60
AI_FAILURE_COOLDOWN=120
AI_DEMO_MODE=auto

# 1. Groq (High-Speed Free AI: qwen/qwen3.8-27b, openai/gpt-oss-120b)
# Get free key from https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# 2. OpenRouter (Free Models: nvidia/nemotron-3.5-lightning:free, google/gemma-4-31b-it:free)
# Get free key from https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

# 3. Google Gemini (Free Tier: gemma-4-26b-a4b-it, gemini-2.5-flash)
# Get free key from https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemma-4-26b-a4b-it
AI_GEMINI_THINKING_BUDGET=0

# 4. Hugging Face Inference API
# Get key from https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=

# 5. NVIDIA NIM (Optional)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=deepseek-ai/deepseek-v4.1-flash

# Security / Secret Token
APP_SECRET_TOKEN=

# Rate limits for expensive actions
RATE_LIMIT_ENABLED=true
SESSION_COOKIE_SECURE=false
