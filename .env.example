# ------------------------------------------------------------------
# LearnForge AI - environment configuration
# Copy this file to .env and adjust the values.
# ------------------------------------------------------------------

# Flask session signing key. Use a long random string in production.
SECRET_KEY=change-me-to-a-long-random-string

# SQLite database location (optional - defaults to instance/app.db)
# DATABASE_URL=sqlite:///instance/app.db

# Seeded administrator (created on first run, never through public signup)
ADMIN_NAME=Platform Administrator
ADMIN_EMAIL=admin@learnforge.com
ADMIN_PASSWORD=Admin@12345

# ------------------------------------------------------------------
# AI provider
# Default: NVIDIA NIM running DeepSeek V4.1 Flash.
# Get an NVIDIA API key from https://build.nvidia.com/ (API Keys).
# Leave the key empty to run in clearly labelled demo mode.
# AI_PROVIDER supports: nvidia | gemini | openai | openrouter | groq
# ------------------------------------------------------------------
AI_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=deepseek-ai/deepseek-v4.1-flash

# Generic overrides (the NVIDIA_* variables above take precedence for NVIDIA)
AI_MODEL=deepseek-ai/deepseek-v4.1-flash
AI_BASE_URL=
AI_TIMEOUT=120
AI_TOP_P=0.95
# After a provider timeout/5xx, skip live calls for this many seconds and use
# clearly labelled demo content instead of making every request wait again.
AI_FAILURE_COOLDOWN=300

# Optional alternate provider. Set AI_PROVIDER=gemini to use this key.
GEMINI_API_KEY=
# Gemini 3.x thinking budget (0 = fastest, JSON-safe responses)
AI_GEMINI_THINKING_BUDGET=0

# auto = demo only when no key / demo on failure fallback
# on   = always demo (offline)
# off  = always require live AI (errors if unavailable)
AI_DEMO_MODE=auto
AI_TEMPERATURE=0.55

# Rate limits for expensive actions (requests per window, in seconds)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AI=8
RATE_LIMIT_AI_WINDOW=600
RATE_LIMIT_LOGIN=12
RATE_LIMIT_LOGIN_WINDOW=900

# Set to true only when serving over HTTPS
SESSION_COOKIE_SECURE=false
